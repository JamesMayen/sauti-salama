# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB connection string (backend-only)
MONGO_URI=

# JWT signing secret; use a strong random value of at least 32 characters
JWT_SECRET=

# Reserved for Phase 4; not required for local startup
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# General API rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# Online evidence retrieval (free DuckDuckGo fallback; SerpAPI optional for better results)
# SERPAPI_KEY=

# SMS provider configuration
SMS_PROVIDER=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENVIRONMENT=sandbox
SMS_WEBHOOK_SECRET=